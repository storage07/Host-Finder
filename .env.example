# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# PORT: Server port (must be 3000 in AI Studio preview)
PORT=3000
NODE_ENV=development

# MONGO_URI: MongoDB Atlas connection string
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/host_finder?retryWrites=true&w=majority
MONGO_URI=""

# Security & Encryption Secrets (generate strong 32+ char secrets for production)
JWT_SECRET="replace-with-strong-random-jwt-secret-min-32-chars"
ENCRYPTION_KEY="replace-with-strong-32-byte-encryption-secret"

# Production Admin Password Override (used on initial seed in production)
ADMIN_INITIAL_PASSWORD="HostFinder@2026!"
