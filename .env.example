# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: Server port (must be 3000 in AI Studio preview)
PORT=3000
NODE_ENV=development

# MongoDB Atlas Configuration (Required — server exits if unset or unreachable)
# Supports either MONGO_URI or MONGODB_URI
MONGO_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/host_finder?retryWrites=true&w=majority"
# MONGODB_URI=""
MONGO_DB_NAME="host_finder"

# Mongoose Connection Pool & Timeout Configuration
MONGO_MIN_POOL_SIZE=2
MONGO_MAX_POOL_SIZE=10
MONGO_SERVER_SELECTION_TIMEOUT_MS=8000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_MAX_IDLE_TIME_MS=30000

# Security & Encryption Secrets (generate strong 32+ char secrets for production)
JWT_SECRET="replace-with-strong-random-jwt-secret-min-32-chars"
ENCRYPTION_KEY="replace-with-strong-32-byte-encryption-secret"

# Production Admin Password Override (used on initial seed in production)
ADMIN_INITIAL_PASSWORD="HostFinder@2026!"
